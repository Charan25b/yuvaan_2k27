generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
  SUPERADMIN
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum PointLedgerType {
  INDIVIDUAL
  FACTION
}

enum PointTransactionType {
  AWARD
  ADJUSTMENT
  REVERSAL
}

enum GameStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum GameSessionStatus {
  IN_PROGRESS
  SUBMITTED
  VALIDATED
  REJECTED
  EXPIRED
}

enum ChallengeStatus {
  PENDING
  ACCEPTED
  COMPLETED
  DECLINED
  EXPIRED
  CANCELLED
}

enum ChallengeResult {
  CHALLENGER_WON
  OPPONENT_WON
  DRAW
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  passwordHash    String?
  emailVerifiedAt DateTime?
  role            UserRole  @default(USER)
  sessionVersion  Int       @default(0)
  playerQR        PlayerQR?

  accounts                Account[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  emailOtpChallenges      EmailOtpChallenge[]
  eventRegistrations      EventRegistration[]
  factionMemberships      FactionMembership[]
  pointTransactions       PointTransaction[]
  challengesCreated       GameChallenge[]          @relation("ChallengeChallenger")
  challengesReceived      GameChallenge[]          @relation("ChallengeOpponent")

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  gameSessions GameSession[]

  @@index([role])
  @@map("users")
}

model Account {
  id                String @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailOtpChallenge {
  id         String    @id @default(cuid())
  userId     String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("email_otp_challenges")
}

model EventCategory {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  isActive    Boolean @default(true)

  events Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("event_categories")
}

model Event {
  id          String      @id @default(cuid())
  title       String
  slug        String      @unique
  description String
  status      EventStatus @default(DRAFT)

  categoryId String
  category   EventCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  venue                String?
  startTime            DateTime
  endTime              DateTime
  registrationDeadline DateTime?
  maxParticipants      Int?
  coverImageUrl        String?

  registrations EventRegistration[]
  schedules     EventSchedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, startTime])
  @@index([categoryId, status])
  @@map("events")
}

model EventRegistration {
  id             String    @id @default(cuid())
  userId         String
  eventId        String
  registeredAt   DateTime  @default(now())
  participatedAt DateTime?

  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@unique([userId, eventId])
  @@index([eventId, registeredAt])
  @@index([userId, registeredAt])
  @@map("event_registrations")
}

model EventSchedule {
  id          String   @id @default(cuid())
  eventId     String
  title       String
  description String?
  venue       String?
  startTime   DateTime
  endTime     DateTime
  sortOrder   Int      @default(0)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId, startTime])
  @@map("event_schedules")
}

model Faction {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  color       String  @default("#063b32")
  emblemUrl   String?
  isActive    Boolean @default(true)

  memberships       FactionMembership[]
  pointTransactions PointTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("factions")
}

model FactionMembership {
  id        String    @id @default(cuid())
  userId    String
  factionId String
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?
  isActive  Boolean   @default(true)

  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  faction Faction @relation(fields: [factionId], references: [id], onDelete: Restrict)

  @@index([userId, isActive])
  @@index([factionId, isActive])
  @@map("faction_memberships")
}

model PointTransaction {
  id              String               @id @default(cuid())
  ledgerType      PointLedgerType
  transactionType PointTransactionType

  // Exactly one recipient should be populated:
  userId    String?
  factionId String?

  // Positive or negative, depending on the transaction.
  amount Int

  // Identifies the activity that generated the points.
  sourceType String
  sourceId   String?

  // Unique key for idempotent point awards.
  idempotencyKey String @unique

  // Optional reference to the transaction being reversed.
  reversesId String?
  reverses   PointTransaction?  @relation("PointReversals", fields: [reversesId], references: [id], onDelete: Restrict)
  reversedBy PointTransaction[] @relation("PointReversals")

  // Optional explanation for adjustments or reversals.
  reason String?

  createdAt DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: Restrict)
  faction Faction? @relation(fields: [factionId], references: [id], onDelete: Restrict)

  @@index([ledgerType, createdAt])
  @@index([userId, createdAt])
  @@index([factionId, createdAt])
  @@index([sourceType, sourceId])
  @@map("point_transactions")
}

model Game {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  status      GameStatus @default(DRAFT)

  // Base scoring configuration.
  individualPoints Int @default(0)
  factionPoints    Int @default(0)

  // Allows a game to be disabled without deleting its history.
  coverImageUrl String?

  sessions   GameSession[]
  challenges GameChallenge[]
  accessQrs  GameAccessQR[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, name])
  @@map("games")
}

model PlayerQR {
  id       String  @id @default(cuid())
  userId   String  @unique
  publicId String  @unique @default(cuid())
  isActive Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("player_qrs")
}

model GameAccessQR {
  id        String    @id @default(cuid())
  publicId  String    @unique @default(cuid())
  gameId    String
  isActive  Boolean   @default(true)
  expiresAt DateTime?

  game Game @relation(fields: [gameId], references: [id], onDelete: Restrict)

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  sessions  GameSession[]

  @@index([gameId, isActive])
  @@map("game_access_qrs")
}

model GameSession {
  id     String            @id @default(cuid())
  userId String
  gameId String
  status GameSessionStatus @default(IN_PROGRESS)

  challengeId String?
  accessQrId  String?
  playDate    String

  startedAt       DateTime  @default(now())
  submittedAt     DateTime?
  validatedAt     DateTime?
  expiresAt       DateTime
  score           Int?
  rejectionReason String?

  user      User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  game      Game           @relation(fields: [gameId], references: [id], onDelete: Restrict)
  challenge GameChallenge? @relation(fields: [challengeId], references: [id], onDelete: Restrict)
  accessQR  GameAccessQR?  @relation(fields: [accessQrId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([challengeId, userId])
  @@index([userId, startedAt])
  @@index([userId, playDate])
  @@index([gameId, status])
  @@index([challengeId])
  @@map("game_sessions")
}

model GameChallenge {
  id           String @id @default(cuid())
  gameId       String
  challengerId String
  opponentId   String

  status ChallengeStatus  @default(PENDING)
  result ChallengeResult?

  createdAt   DateTime  @default(now())
  acceptedAt  DateTime?
  completedAt DateTime?
  expiresAt   DateTime

  game       Game          @relation(fields: [gameId], references: [id], onDelete: Restrict)
  challenger User          @relation("ChallengeChallenger", fields: [challengerId], references: [id], onDelete: Restrict)
  opponent   User          @relation("ChallengeOpponent", fields: [opponentId], references: [id], onDelete: Restrict)
  sessions   GameSession[]

  @@index([challengerId, status, createdAt])
  @@index([opponentId, status, createdAt])
  @@index([gameId, status])
  @@map("game_challenges")
}

model Sponsor {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  logoUrl     String?
  websiteUrl  String?
  tier        String
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@index([tier])
  @@map("sponsors")
}

model Team {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  logoUrl     String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  members TeamMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("teams")
}

model TeamMember {
  id          String  @id @default(cuid())
  teamId      String
  name        String
  designation String
  bio         String?
  photoUrl    String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId, isActive, sortOrder])
  @@map("team_members")
}

model GalleryImage {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String
  altText     String
  category    String?
  eventYear   Int
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, eventYear, sortOrder])
  @@index([category])
  @@map("gallery_images")
}

model Merchandise {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  description    String?
  imageUrl       String?
  price          Decimal? @db.Decimal(10, 2)
  orderFormUrl   String?
  availability   String   @default("AVAILABLE")
  sortOrder      Int      @default(0)
  isPublished    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isPublished, sortOrder])
  @@index([availability])
  @@map("merchandise")
}