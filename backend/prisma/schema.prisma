generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
  SUPERADMIN
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  passwordHash    String?
  emailVerifiedAt DateTime?
  role            UserRole  @default(USER)
  sessionVersion  Int       @default(0)

  accounts                Account[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  emailOtpChallenges      EmailOtpChallenge[]
  eventRegistrations      EventRegistration[]
  factionMemberships      FactionMembership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@map("users")
}

model Account {
  id                String @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailOtpChallenge {
  id         String    @id @default(cuid())
  userId     String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("email_otp_challenges")
}

model EventCategory {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  isActive    Boolean @default(true)

  events Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("event_categories")
}

model Event {
  id          String      @id @default(cuid())
  title       String
  slug        String      @unique
  description String
  status      EventStatus @default(DRAFT)

  categoryId String
  category   EventCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  venue                String?
  startTime            DateTime
  endTime              DateTime
  registrationDeadline DateTime?
  maxParticipants      Int?
  coverImageUrl        String?

  registrations EventRegistration[]
  schedules     EventSchedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, startTime])
  @@index([categoryId, status])
  @@map("events")
}

model EventRegistration {
  id             String    @id @default(cuid())
  userId         String
  eventId        String
  registeredAt   DateTime  @default(now())
  participatedAt DateTime?

  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@unique([userId, eventId])
  @@index([eventId, registeredAt])
  @@index([userId, registeredAt])
  @@map("event_registrations")
}

model EventSchedule {
  id          String   @id @default(cuid())
  eventId     String
  title       String
  description String?
  venue       String?
  startTime   DateTime
  endTime     DateTime
  sortOrder   Int      @default(0)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId, startTime])
  @@map("event_schedules")
}

model Faction {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  color       String  @default("#063b32")
  emblemUrl   String?
  isActive    Boolean @default(true)

  memberships FactionMembership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("factions")
}

model FactionMembership {
  id        String    @id @default(cuid())
  userId    String
  factionId String
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?
  isActive  Boolean   @default(true)

  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  faction Faction @relation(fields: [factionId], references: [id], onDelete: Restrict)

  @@index([userId, isActive])
  @@index([factionId, isActive])
  @@map("faction_memberships")
}
